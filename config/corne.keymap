#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"

/ {
    keymap {
        // Explicit tables for the five layers in use; other layers remain inherited.
        // Each outlined cell labels its zero-based physical position and Base-layer key.
        // The binding directly below each label is that key's action on the current layer.
        // &trans inherits the next lower active layer; U_NA disables a position.
        BASE {
            // Tap Enter / hold Super; tap Delete / hold Fun.
            bindings = <
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +----------------+-----------+-----------------+-----------+--------------+------------+
                // | 00: Esc        | 01: Q    | 02: W       | 03: E         | 04: R             | 05: T     |    | 06: Y          | 07: U     | 08: I           | 09: O     | 10: P        | 11: Bksp   |
                     &kp ESC          &kp Q      &kp W         &kp E           &kp R               &kp T            &kp Y            &kp U       &kp I             &kp O       &kp P          &kp BSPC
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +----------------+-----------+-----------------+-----------+--------------+------------+
                // | 12: Tab        | 13: A    | 14: S       | 15: D         | 16: F             | 17: G     |    | 18: H          | 19: J     | 20: K           | 21: L     | 22: ;        | 23: Quote  |
                     &kp TAB          &kp A      &kp S         &kp D           &kp F               &kp G            &kp H            &kp J       &kp K             &kp L       &kp SEMI       &kp SQT
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +----------------+-----------+-----------------+-----------+--------------+------------+
                // | 24: LShift     | 25: Z    | 26: X       | 27: C         | 28: V             | 29: B     |    | 30: N          | 31: M     | 32: Comma       | 33: Dot   | 34: Slash    | 35: RShift |
                     &kp LSHFT        &kp Z      &kp X         &kp C           &kp V               &kp B            &kp N            &kp M       &kp COMMA         &kp DOT     &kp SLASH      &kp RSHFT
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +----------------+-----------+-----------------+-----------+--------------+------------+
                //                                           +---------------+-------------------+-----------+    +----------------+-----------+-----------------+
                //                                           | 36: Alt       | 37: Space         | 38: Ctrl  |    | 39: Enter      | 40: Num   | 41: Delete      |
                                                               &kp LALT        &u_lt U_NAV SPACE   &kp LCTRL        &u_mt LGUI RET   &mo U_NUM   &u_lt U_FUN DEL
                //                                           +---------------+-------------------+-----------+    +----------------+-----------+-----------------+
            >;
        };

        NAV {
            // Shift the home-row arrows left to H/J/K/L; move Caps Word to semicolon.
            // Shift Home/Page Down/Page Up/End left to N/M/comma/dot; move Insert to slash.
            // Y: Ctrl+Left; O: Ctrl+Right (replaces Redo and Cut).
            // Hold Tab while on Nav to activate Media.
            // Unassigned outer-column keys inherit the next lower active layer.
            bindings = <
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +--------------+-----------+------------+---------------+--------------+------------+
                // | 00: Esc        | 01: Q    | 02: W       | 03: E         | 04: R             | 05: T     |    | 06: Y        | 07: U     | 08: I      | 09: O         | 10: P        | 11: Bksp   |
                     &studio_unlock   U_BOOT     &u_to_U_TAP   &u_to_U_EXTRA   &u_to_U_BASE        U_NA             &kp LC(LEFT)   U_PST       U_CPY        &kp LC(RIGHT)   U_UND          &trans
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +--------------+-----------+------------+---------------+--------------+------------+
                // | 12: Tab        | 13: A    | 14: S       | 15: D         | 16: F             | 17: G     |    | 18: H        | 19: J     | 20: K      | 21: L         | 22: ;        | 23: Quote  |
                     &mo U_MEDIA      &kp LGUI   &kp LALT      &kp LCTRL       &kp LSHFT           U_NA             &kp LEFT       &kp DOWN    &kp UP       &kp RIGHT       &u_caps_word   &trans
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +--------------+-----------+------------+---------------+--------------+------------+
                // | 24: LShift     | 25: Z    | 26: X       | 27: C         | 28: V             | 29: B     |    | 30: N        | 31: M     | 32: Comma  | 33: Dot       | 34: Slash    | 35: RShift |
                     &trans           U_NA       &kp RALT      &u_to_U_NUM     &u_to_U_NAV         U_NA             &kp HOME       &kp PG_DN   &kp PG_UP    &kp END         &kp INS        &trans
                // +----------------+----------+-------------+---------------+-------------------+-----------+    +--------------+-----------+------------+---------------+--------------+------------+
                //                                           +---------------+-------------------+-----------+    +--------------+-----------+------------+
                //                                           | 36: Alt       | 37: Space         | 38: Ctrl  |    | 39: Enter    | 40: Num   | 41: Delete |
                                                               U_NA            U_NA                U_NA             &kp RET        &kp BSPC    &kp DEL
                //                                           +---------------+-------------------+-----------+    +--------------+-----------+------------+
            >;
        };

        MEDIA {
            bindings = <
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 00: Esc        | 01: Q     | 02: W       | 03: E         | 04: R             | 05: T           |    | 06: Y      | 07: U        | 08: I         | 09: O        | 10: P        | 11: Bksp   |
                     &studio_unlock   U_BOOT      &u_to_U_TAP   &u_to_U_EXTRA   &u_to_U_BASE        U_NA                   U_RGB_TOG    U_RGB_EFF      U_RGB_HUI       U_RGB_SAI      U_RGB_BRI      &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 12: Tab        | 13: A     | 14: S       | 15: D         | 16: F             | 17: G           |    | 18: H      | 19: J        | 20: K         | 21: L        | 22: ;        | 23: Quote  |
                     &trans           &kp LGUI    &kp LALT      &kp LCTRL       &kp LSHFT           U_NA                   U_EP_TOG     &kp C_PREV     &kp C_VOL_DN    &kp C_VOL_UP   &kp C_NEXT     &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 24: LShift     | 25: Z     | 26: X       | 27: C         | 28: V             | 29: B           |    | 30: N      | 31: M        | 32: Comma     | 33: Dot      | 34: Slash    | 35: RShift |
                     &trans           U_NA        &kp RALT      &u_to_U_FUN     &u_to_U_MEDIA       U_NA                   &u_out_tog   &u_bt_sel_0    &u_bt_sel_1     &u_bt_sel_2    &u_bt_sel_3    &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
                //                                            | 36: Alt       | 37: Space         | 38: Ctrl        |    | 39: Enter  | 40: Num      | 41: Delete    |
                                                                U_NA            U_NA                U_NA                   &kp C_STOP   &kp C_PP       &kp C_MUTE
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
            >;
        };

        NUM {
            bindings = <
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 00: Esc        | 01: Q     | 02: W       | 03: E         | 04: R             | 05: T           |    | 06: Y      | 07: U        | 08: I         | 09: O        | 10: P        | 11: Bksp   |
                     &studio_unlock   &kp LBKT    &kp N7        &kp N8          &kp N9              &kp RBKT               U_NA         &u_to_U_BASE   &u_to_U_EXTRA   &u_to_U_TAP    U_BOOT         &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 12: Tab        | 13: A     | 14: S       | 15: D         | 16: F             | 17: G           |    | 18: H      | 19: J        | 20: K         | 21: L        | 22: ;        | 23: Quote  |
                     &trans           &kp MINUS   &kp N4        &kp N5          &kp N6              &kp EQUAL              U_NA         &kp LSHFT      &kp LCTRL       &kp LALT       &kp LGUI       &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 24: LShift     | 25: Z     | 26: X       | 27: C         | 28: V             | 29: B           |    | 30: N      | 31: M        | 32: Comma     | 33: Dot      | 34: Slash    | 35: RShift |
                     &trans           &kp GRAVE   &kp N1        &kp N2          &kp N3              &kp BSLH               U_NA         &u_to_U_NUM    &u_to_U_NAV     &kp RALT       U_NA           &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
                //                                            | 36: Alt       | 37: Space         | 38: Ctrl        |    | 39: Enter  | 40: Num      | 41: Delete    |
                                                                &kp DOT         &kp N0              &kp LCTRL              U_NA         U_NA           U_NA
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
            >;
        };

        FUN {
            bindings = <
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 00: Esc        | 01: Q     | 02: W       | 03: E         | 04: R             | 05: T           |    | 06: Y      | 07: U        | 08: I         | 09: O        | 10: P        | 11: Bksp   |
                     &studio_unlock   &kp F12     &kp F7        &kp F8          &kp F9              &kp PSCRN              U_NA         &u_to_U_BASE   &u_to_U_EXTRA   &u_to_U_TAP    U_BOOT         &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 12: Tab        | 13: A     | 14: S       | 15: D         | 16: F             | 17: G           |    | 18: H      | 19: J        | 20: K         | 21: L        | 22: ;        | 23: Quote  |
                     &trans           &kp F11     &kp F4        &kp F5          &kp F6              &kp SLCK               U_NA         &kp LSHFT      &kp LCTRL       &kp LALT       &kp LGUI       &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                // | 24: LShift     | 25: Z     | 26: X       | 27: C         | 28: V             | 29: B           |    | 30: N      | 31: M        | 32: Comma     | 33: Dot      | 34: Slash    | 35: RShift |
                     &trans           &kp F10     &kp F1        &kp F2          &kp F3              &kp PAUSE_BREAK        U_NA         &u_to_U_FUN    &u_to_U_MEDIA   &kp RALT       U_NA           &trans
                // +----------------+-----------+-------------+---------------+-------------------+-----------------+    +------------+--------------+---------------+--------------+--------------+------------+
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
                //                                            | 36: Alt       | 37: Space         | 38: Ctrl        |    | 39: Enter  | 40: Num      | 41: Delete    |
                                                                &kp K_APP       &kp SPACE           &kp TAB                U_NA         U_NA           U_NA
                //                                            +---------------+-------------------+-----------------+    +------------+--------------+---------------+
            >;
        };
    };
};
