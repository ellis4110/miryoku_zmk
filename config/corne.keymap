#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"
/ {
    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };

        combo_f_tab_shift {
            timeout-ms = <50>;
            key-positions = <16 38>;
            bindings = <&kp LSHFT>;
            layers = <0>;
        };
    };
};
