#include "../miryoku/custom_config.h"
#include "../miryoku/mapping/42/corne.h"
#include "../miryoku/miryoku.dtsi"

#define MOD_CHORD(NAME, THUMB, BINDING, ...) \
    NAME { \
        timeout-ms = <50>; \
        key-positions = <THUMB __VA_ARGS__>; \
        bindings = <BINDING>; \
        layers = <U_BASE>; \
    };

// G, A, C, S: positions for Super, Alt, Ctrl, Shift.
#define MOD_SET(PREFIX, THUMB, G, A, C, S, BINDING) \
    MOD_CHORD(PREFIX##_gui, THUMB, BINDING LGUI, G) \
    MOD_CHORD(PREFIX##_alt, THUMB, BINDING LALT, A) \
    MOD_CHORD(PREFIX##_ctrl, THUMB, BINDING LCTRL, C) \
    MOD_CHORD(PREFIX##_shift, THUMB, BINDING LSHFT, S) \
    MOD_CHORD(PREFIX##_gui_alt, THUMB, BINDING LA(LGUI), G A) \
    MOD_CHORD(PREFIX##_gui_ctrl, THUMB, BINDING LC(LGUI), G C) \
    MOD_CHORD(PREFIX##_gui_shift, THUMB, BINDING LS(LGUI), G S) \
    MOD_CHORD(PREFIX##_alt_ctrl, THUMB, BINDING LC(LALT), A C) \
    MOD_CHORD(PREFIX##_alt_shift, THUMB, BINDING LS(LALT), A S) \
    MOD_CHORD(PREFIX##_ctrl_shift, THUMB, BINDING LS(LCTRL), C S) \
    MOD_CHORD(PREFIX##_gui_alt_ctrl, THUMB, BINDING LC(LA(LGUI)), G A C) \
    MOD_CHORD(PREFIX##_gui_alt_shift, THUMB, BINDING LS(LA(LGUI)), G A S) \
    MOD_CHORD(PREFIX##_gui_ctrl_shift, THUMB, BINDING LS(LC(LGUI)), G C S) \
    MOD_CHORD(PREFIX##_alt_ctrl_shift, THUMB, BINDING LS(LC(LALT)), A C S) \
    MOD_CHORD(PREFIX##_all, THUMB, BINDING LS(LC(LA(LGUI))), G A C S)

/ {
    macros {
        // Parameter 1: layer. Parameter 2: modifier combination.
        chord_layer_mod: chord_layer_mod {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            wait-ms = <0>;
            tap-ms = <0>;

            bindings
                = <&macro_param_1to1>
                , <&macro_press &mo 0>
                , <&macro_param_2to1>
                , <&macro_press &kp 0>
                , <&macro_pause_for_release>
                , <&macro_param_2to1>
                , <&macro_release &kp 0>
                , <&macro_param_1to1>
                , <&macro_release &mo 0>
                ;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_studio_unlock {
            timeout-ms = <50>;
            key-positions = <0 11>;
            bindings = <&studio_unlock>;
        };

        // Tab + left-hand modifiers.
        MOD_SET(tab, 38, 13, 14, 15, 16, &kp)

        // Enter + right-hand modifiers.
        MOD_SET(enter, 39, 22, 21, 20, 19, &kp)

        // Space + left-hand modifiers: Nav + modifiers.
        MOD_SET(nav, 37, 13, 14, 15, 16, &chord_layer_mod U_NAV)

        // Backspace + right-hand modifiers: Num + modifiers.
        MOD_SET(num, 40, 22, 21, 20, 19, &chord_layer_mod U_NUM)
    };
};

#undef MOD_SET
#undef MOD_CHORD
